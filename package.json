{
  "name": "miniapps-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @repo/main dev",
    "dev:dashboard": "pnpm --filter @repo/dashboard dev",
    "dev:admin": "pnpm --filter @repo/admin dev",
    "dev:booking": "pnpm --filter @repo/booking dev",
    "dev:portfolio": "pnpm --filter @repo/portfolio dev",
    "build": "turbo run build --filter=@repo/main",
    "build:all": "turbo run build --filter=@repo/main --filter=@repo/dashboard --filter=@repo/admin --filter=@repo/booking",
    "build:changed": "node scripts/ci/run-changed-build.mjs",
    "start": "pnpm --filter @repo/main start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @repo/main test:e2e",
    "test:coverage": "pnpm --filter @repo/shared test:coverage",
    "security:audit": "pnpm audit --audit-level=critical",
    "security:licenses": "node scripts/ci/license-check.mjs",
    "db:up": "node scripts/db-up.mjs",
    "db:down": "docker stop miniapps-postgres >/dev/null 2>&1; docker rm miniapps-postgres >/dev/null 2>&1; docker compose down 2>/dev/null || true",
    "db:migrate": "DATABASE_URL=${DATABASE_URL:-postgresql://miniapps:miniapps@localhost:5433/miniapps} pnpm --filter @repo/db db:migrate",
    "db:push": "DATABASE_URL=${DATABASE_URL:-postgresql://miniapps:miniapps@localhost:5433/miniapps} pnpm --filter @repo/db db:push",
    "db:seed": "DATABASE_URL=${DATABASE_URL:-postgresql://miniapps:miniapps@localhost:5433/miniapps} pnpm --filter @repo/db db:seed",
    "db:setup": "pnpm db:up && pnpm db:push && pnpm db:seed",
    "req:next": "node scripts/req-action.mjs next",
    "req:status": "node scripts/req-action.mjs status",
    "req:start": "node scripts/req-action.mjs start",
    "req:stop": "node scripts/req-action.mjs stop",
    "req:done": "node scripts/req-action.mjs done",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "turbo": "^2.5.4",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
